VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Web push only. The public key is safe to ship in the client bundle;
# the matching private key must NEVER go here, in the repo, or in any
# client code. It lives only as a server secret on the push sender.
# Until this is set, the Push toggle reports "not configured" and stays
# off. See docs/web-push.md. Do not invent or commit a real key.
VITE_VAPID_PUBLIC_KEY=
